# ============================================
# LLM Provider — Pick ONE
# ============================================

# Option 1: Anthropic Claude (recommended)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Option 2: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxx
# OPENAI_MODEL=gpt-4o

# Option 3: OpenAI-compatible provider (Mistral, Groq, etc.)
# LLM_PROVIDER=openai_compatible
# OPENAI_API_KEY=your-key
# OPENAI_BASE_URL=https://api.mistral.ai/v1
# OPENAI_MODEL=mistral-large-latest

# ============================================
# Google (only needed once you turn OFF Simulation Mode in the UI)
# Personal OAuth2 — no Workspace domain required.
# Run `python3 authorize_google.py` on your host machine first; see
# SETUP_OAUTH.md for the one-time Google Cloud Console steps.
# ============================================
# Path (inside the container) to the cached OAuth token created by
# authorize_google.py. Leave as default unless you changed the mount.
GOOGLE_TOKEN_PATH=/app/credentials/token.json

# Optional: put new employees' Drive folders inside this existing folder
# instead of your Drive root. Leave blank to use Drive root.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Optional: which calendar to book meetings on. "primary" = your main calendar.
GOOGLE_CALENDAR_ID=primary

# ============================================
# App Config
# ============================================
APP_ENV=development
LOG_LEVEL=INFO
COMPANY_NAME=YourCompany
COMPANY_DOMAIN=yourcompany.com
